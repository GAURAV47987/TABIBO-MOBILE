{
  "expo": {
    "name": "TABIGO",
    "slug": "tabigo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FBF8FF",
    "splash": {
      "backgroundColor": "#FBF8FF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tabigo.app"
    },
    "android": {
      "package": "com.tabigo.app",
      "adaptiveIcon": {
        "backgroundColor": "#FBF8FF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "TABIGO uses your photos to let you set a profile picture and attach booking confirmations or travel documents to your trips.",
          "cameraPermission": "TABIGO uses the camera so you can photograph tickets, booking confirmations or travel documents and save them to your trip."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#7C5CFC",
          "defaultChannel": "trip-reminders"
        }
      ],
      "@sentry/react-native"
    ]
  }
}
